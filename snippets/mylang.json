{
  "var": {
    "prefix": "var",
    "body": ["var ${1:name} = ${2:value};"],
    "description": "variable declaration"
  },
  "func": {
    "prefix": "func",
    "body": ["func ${1:name}(${2}) {", "\t$0", "}"],
    "description": "function declaration"
  },
  "dispose member": {
    "prefix": "dispose",
    "body": ["func [symbol.dispose]() {", "\t$0", "}"],
    "description": "struct member released by defer (MyLang2 2.3)"
  },
  "iterator member": {
    "prefix": "iterator",
    "body": ["func [symbol.iterator]() {", "\treturn ${1:iter.Iterator(this.${2:items})};", "}"],
    "description": "struct member walked by `for … in` (MyLang2 2.3)"
  },
  "struct resource": {
    "prefix": "structresource",
    "body": [
      "struct ${1:Resource} {",
      "\tprivate var ${2:handle};",
      "",
      "\tfunc init(${3}) {",
      "\t\tthis.${2:handle} = ${4:nil};",
      "\t}",
      "",
      "\tfunc [symbol.dispose]() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "struct that owns a resource and releases it (MyLang2 2.3)"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\tvar ${2:field};",
      "",
      "\tfunc init(${3}) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "struct with constructor"
  },
  "enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "\t${2:First};", "\t${3:Second};", "}"],
    "description": "enumeration"
  },
  "if": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t$0", "}"],
    "description": "if statement"
  },
  "ifelse": {
    "prefix": "ifelse",
    "body": ["if (${1:condition}) {", "\t$2", "} else {", "\t$0", "}"],
    "description": "if / else"
  },
  "for": {
    "prefix": "for",
    "body": ["for (var ${1:i} = 0; ${1:i} < ${2:count}; ${1:i}++) {", "\t$0", "}"],
    "description": "for loop"
  },
  "forin": {
    "prefix": "forin",
    "body": ["for (var ${1:item} in ${2:items}) {", "\t$0", "}"],
    "description": "for-in loop"
  },
  "while": {
    "prefix": "while",
    "body": ["while (${1:condition}) {", "\t$0", "}"],
    "description": "while loop"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match (${1:value}) {",
      "\tcase (${2:pattern}): {",
      "\t\t$3",
      "\t}",
      "\tdefault: {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "match statement"
  },
  "try": {
    "prefix": "try",
    "body": ["try {", "\t$1", "} catch (${2:err}) {", "\t$0", "}"],
    "description": "try / catch"
  },
  "tryfinally": {
    "prefix": "tryfinally",
    "body": ["try {", "\t$1", "} catch (${2:err}) {", "\t$3", "} finally {", "\t$0", "}"],
    "description": "try / catch / finally"
  },
  "import": {
    "prefix": "import",
    "body": ["import \"core:${1:coreio}\";"],
    "description": "import a module"
  },
  "importmany": {
    "prefix": "importmany",
    "body": ["import (", "\t\"core:${1:coreio}\",", "\t\"core:${2:fs}\",", ");"],
    "description": "import several modules"
  },
  "export": {
    "prefix": "export",
    "body": ["export(${1:name});"],
    "description": "export symbols"
  },
  "spawn": {
    "prefix": "spawn",
    "body": ["spawn {", "\t$0", "}"],
    "description": "run a block as a task"
  },
  "defer": {
    "prefix": "defer",
    "body": ["defer ${1:cleanup()};"],
    "description": "run on scope exit"
  },
  "main": {
    "prefix": "main",
    "body": ["import \"core:coreio\";", "", "coreio.print(\"${1:Hello, MyLang2!}\");", ""],
    "description": "hello world"
  },
  "print": {
    "prefix": "print",
    "body": ["coreio.print($0);"],
    "description": "print to console (needs import \"core:coreio\")"
  },
  "http server": {
    "prefix": "httpserver",
    "body": [
      "import (",
      "\t\"core:coreio\",",
      "\t\"core:net/http\",",
      ");",
      "",
      "var server = http.Server({",
      "\tonError: func(event) {",
      "\t\tcoreio.print($\"{event.kind} {event.status} {event.method} {event.path}: {event.message}\");",
      "\t},",
      "});",
      "",
      "server.get(\"/\", func(ctx) {",
      "\treturn ctx.send(\"${1:Hello}\");",
      "});",
      "",
      "server.listen(${2:3000}, func() {",
      "\tcoreio.print(\"Server running on http://localhost:${2:3000}\");",
      "});"
    ],
    "description": "HTTP server skeleton"
  },
  "importas": {
    "prefix": "importas",
    "body": ["import \"core:${1:test}\" as { ${2:describe, test, assert, finish} };"],
    "description": "import selected members of a module"
  },
  "test file": {
    "prefix": "testfile",
    "body": [
      "import \"core:test\" as { describe, test, assert, finish };",
      "",
      "describe(\"${1:unit}\", func() {",
      "\ttest(\"${2:does something}\", func() {",
      "\t\tassert.equal(${3:actual}, ${4:expected});",
      "\t});",
      "});",
      "",
      "finish(\"${1:unit}\");"
    ],
    "description": "test file skeleton (core:test)"
  },
  "tcp server": {
    "prefix": "tcpserver",
    "body": [
      "import (",
      "\t\"core:coreio\",",
      "\t\"core:tcp\",",
      ");",
      "",
      "var server = defer tcp.listen(${1:8080});",
      "",
      "server.accept(func(client) {",
      "\tdefer client.close();",
      "\tcoreio.print(client.read());",
      "\tclient.write(\"${2:hello}\\n\");",
      "});"
    ],
    "description": "TCP server skeleton (core:tcp)"
  }
}
