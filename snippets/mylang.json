{
  "var": {
    "prefix": "var",
    "body": ["var ${1:name} = ${2:value};"],
    "description": "variable declaration"
  },
  "func": {
    "prefix": "func",
    "body": ["func ${1:name}(${2}) {", "\t$0", "}"],
    "description": "function declaration"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\tvar ${2:field};",
      "",
      "\tfunc init(${3}) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "struct with constructor"
  },
  "enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "\t${2:First};", "\t${3:Second};", "}"],
    "description": "enumeration"
  },
  "if": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t$0", "}"],
    "description": "if statement"
  },
  "ifelse": {
    "prefix": "ifelse",
    "body": ["if (${1:condition}) {", "\t$2", "} else {", "\t$0", "}"],
    "description": "if / else"
  },
  "for": {
    "prefix": "for",
    "body": ["for (var ${1:i} = 0; ${1:i} < ${2:count}; ${1:i}++) {", "\t$0", "}"],
    "description": "for loop"
  },
  "forin": {
    "prefix": "forin",
    "body": ["for (var ${1:item} in ${2:items}) {", "\t$0", "}"],
    "description": "for-in loop"
  },
  "while": {
    "prefix": "while",
    "body": ["while (${1:condition}) {", "\t$0", "}"],
    "description": "while loop"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match (${1:value}) {",
      "\tcase (${2:pattern}): {",
      "\t\t$3",
      "\t}",
      "\tdefault: {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "match statement"
  },
  "try": {
    "prefix": "try",
    "body": ["try {", "\t$1", "} catch (${2:err}) {", "\t$0", "}"],
    "description": "try / catch"
  },
  "tryfinally": {
    "prefix": "tryfinally",
    "body": ["try {", "\t$1", "} catch (${2:err}) {", "\t$3", "} finally {", "\t$0", "}"],
    "description": "try / catch / finally"
  },
  "import": {
    "prefix": "import",
    "body": ["import \"${1:coreio}\";"],
    "description": "import a module"
  },
  "importmany": {
    "prefix": "importmany",
    "body": ["import (", "\t\"${1:coreio}\",", "\t\"${2:fs}\",", ");"],
    "description": "import several modules"
  },
  "export": {
    "prefix": "export",
    "body": ["export(${1:name});"],
    "description": "export symbols"
  },
  "spawn": {
    "prefix": "spawn",
    "body": ["spawn {", "\t$0", "}"],
    "description": "run a block as a task"
  },
  "defer": {
    "prefix": "defer",
    "body": ["defer ${1:cleanup()};"],
    "description": "run on scope exit"
  },
  "main": {
    "prefix": "main",
    "body": ["import \"coreio\";", "", "coreio.print(\"${1:Hello, MyLang2!}\");", ""],
    "description": "hello world"
  },
  "print": {
    "prefix": "print",
    "body": ["coreio.print($0);"],
    "description": "print to console (needs import \"coreio\")"
  },
  "http server": {
    "prefix": "httpserver",
    "body": [
      "import (",
      "\t\"coreio\",",
      "\t\"net/http\",",
      ");",
      "",
      "var server = http.Server();",
      "",
      "server.get(\"/\", func(ctx) {",
      "\treturn ctx.send(\"${1:Hello}\");",
      "});",
      "",
      "server.listen(${2:3000}, func() {",
      "\tcoreio.print(\"Server running on http://localhost:${2:3000}\");",
      "});"
    ],
    "description": "HTTP server skeleton"
  }
}
