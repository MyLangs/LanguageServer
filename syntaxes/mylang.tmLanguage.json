{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MyLang",
  "scopeName": "source.mylang",
  "fileTypes": ["ml"],
  "patterns": [
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "statements": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#members"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.mylang",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.mylang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.mylang"
            }
          },
          "patterns": [
            {
              "include": "#jsdoc"
            }
          ]
        },
        {
          "name": "comment.block.mylang",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.mylang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.mylang"
            }
          }
        },
        {
          "name": "comment.line.double-slash.mylang",
          "match": "(//).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.mylang"
            }
          }
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.mylang",
          "match": "\\\\(?:[ntrbfv0\\\\'\"]|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2})"
        },
        {
          "name": "invalid.illegal.escape.mylang",
          "match": "\\\\."
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.mylang",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.mylang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.mylang"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.interpolated.mylang",
          "begin": "\\$\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.mylang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.mylang"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "name": "meta.interpolation.mylang",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.mylang"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.mylang"
                }
              },
              "patterns": [
                {
                  "include": "#statements"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.mylang",
          "begin": "\"",
          "end": "\"|(?=$)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.mylang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.mylang"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.mylang",
          "begin": "'",
          "end": "'|(?=$)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.mylang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.mylang"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.mylang",
          "match": "\\b0[xX][0-9A-Fa-f_]+n?\\b"
        },
        {
          "name": "constant.numeric.binary.mylang",
          "match": "\\b0[bB][01_]+n?\\b"
        },
        {
          "name": "constant.numeric.octal.mylang",
          "match": "\\b0[oO][0-7_]+n?\\b"
        },
        {
          "name": "constant.numeric.float.mylang",
          "match": "\\b\\d[\\d_]*\\.[\\d_]*(?:[eE][+-]?\\d+)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.bigint.mylang",
          "match": "\\b\\d[\\d_]*n\\b"
        },
        {
          "name": "constant.numeric.integer.mylang",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "storage.type.function.mylang"
            },
            "2": {
              "name": "entity.name.function.mylang"
            }
          }
        },
        {
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.struct.mylang"
            },
            "2": {
              "name": "entity.name.type.struct.mylang"
            }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.enum.mylang"
            },
            "2": {
              "name": "entity.name.type.enum.mylang"
            }
          }
        },
        {
          "match": "\\b(var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.var.mylang"
            },
            "2": {
              "name": "variable.other.definition.mylang"
            }
          }
        },
        {
          "match": "\\b(catch)\\s*\\(\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*\\)",
          "captures": {
            "1": {
              "name": "keyword.control.trycatch.mylang"
            },
            "2": {
              "name": "variable.parameter.mylang"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.mylang",
          "match": "\\b(import|export)\\b"
        },
        {
          "name": "keyword.control.conditional.mylang",
          "match": "\\b(if|else|match|case|default)\\b"
        },
        {
          "name": "keyword.control.loop.mylang",
          "match": "\\b(for|while|break|continue)\\b"
        },
        {
          "name": "keyword.control.trycatch.mylang",
          "match": "\\b(try|catch|finally|throw)\\b"
        },
        {
          "name": "keyword.control.flow.mylang",
          "match": "\\b(return|defer)\\b"
        },
        {
          "name": "keyword.control.async.mylang",
          "match": "\\b(spawn|wait)\\b(?!\\s*\\.)"
        },
        {
          "name": "storage.modifier.mylang",
          "match": "\\b(const|readonly|lazy)\\b"
        },
        {
          "name": "keyword.operator.expression.as.mylang",
          "match": "\\bas\\b"
        },
        {
          "name": "keyword.operator.expression.typeof.mylang",
          "match": "\\btypeof\\b"
        },
        {
          "name": "keyword.operator.expression.in.mylang",
          "match": "\\bin\\b"
        },
        {
          "name": "storage.type.function.mylang",
          "match": "\\bfunc\\b"
        },
        {
          "name": "storage.type.var.mylang",
          "match": "\\bvar\\b"
        },
        {
          "name": "storage.type.struct.mylang",
          "match": "\\b(struct|enum)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.mylang",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.mylang",
          "match": "\\bnil\\b"
        },
        {
          "name": "variable.language.this.mylang",
          "match": "\\bthis\\b"
        },
        {
          "name": "support.variable.global.mylang",
          "match": "\\b(import|wait|symbol|process|global)\\b(?=\\s*\\??\\.)"
        },
        {
          "name": "support.function.builtin.mylang",
          "match": "\\blength\\b(?=\\s*\\()"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "(\\?\\.|\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.mylang"
            },
            "2": {
              "name": "entity.name.function.member.mylang"
            }
          }
        },
        {
          "match": "(\\?\\.|\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.mylang"
            },
            "2": {
              "name": "variable.other.property.mylang"
            }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "meta.function-call.mylang",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.mylang"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rest.mylang",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.assignment.compound.mylang",
          "match": ">>>=|<<=|>>=|\\*\\*=|&&=|\\|\\|=|[+\\-*/%&|^]="
        },
        {
          "name": "keyword.operator.assignment.mylang",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.mylang",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.mylang",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.mylang",
          "match": ">>>|<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.increment.mylang",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.arithmetic.mylang",
          "match": "\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.ternary.mylang",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.mylang",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.mylang",
          "match": ";"
        },
        {
          "name": "punctuation.separator.key-value.mylang",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.mylang",
          "match": "\\."
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.mylang",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "jsdoc": {
      "patterns": [
        {
          "name": "storage.type.annotation.mylang",
          "match": "@[A-Za-z][\\w-]*"
        },
        {
          "name": "entity.name.type.mylang",
          "match": "\\{[^{}\\r\\n]+\\}"
        },
        {
          "name": "variable.parameter.documentation.mylang",
          "match": "(?<=\\})\\s+(?:\\.\\.\\.)?(?:\\[[A-Za-z_$][\\w$]*(?:=[^\\]]+)?\\]|[A-Za-z_$][\\w$]*)(?=\\s|$|\\*)"
        }
      ]
    }
  }
}
